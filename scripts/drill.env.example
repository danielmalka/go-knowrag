# Copy to scripts/drill.env on the operator's host, fill in, and source it before running
# scripts/recovery-drill.sh. `.env.*` is gitignored except for this `.example` — same arrangement as
# scripts/embedder-service/knowrag-embedder.env.example and deploy/.env.example, and for the same
# reason: this repository is public, and none of the values below may be written into a tracked file.
#
#   set -a; . scripts/drill.env; set +a
#   ./scripts/recovery-drill.sh --yes

# How to reach the machine that runs Qdrant, in whatever form ssh accepts: a Host from ~/.ssh/config
# is the better shape here, because then the address itself never leaves that file.
#
# The drill reaches it across the private mesh (ADR-003), which is the same path `knowrag` takes.
KNOWRAG_DRILL_SSH=

# The directory on that machine holding its docker-compose.yml — the one `docker compose down` and
# `docker compose up -d` are run from.
#
# It is NOT deploy/ in this repository, and the difference is why the drill discovers the volume
# name from the running container instead of reading either file: the two have diverged on that
# name (`qdrant-storage` here, `qdrant_storage` there). A drill that trusted a file would remove a
# volume nobody is using and create an empty one, which is the loss it exists to prevent.
KNOWRAG_DRILL_COMPOSE_DIR=

# Where the before/after counts and the transcript are written. Relative paths resolve from the
# working directory; `.drill/` is gitignored. Optional — the scripts default to `.drill`.
#KNOWRAG_DRILL_STATE_DIR=.drill

# How long to wait for Qdrant to answer after the rebuild before giving up and telling the operator
# the index is empty. Optional; defaults to 300 seconds.
#KNOWRAG_DRILL_UP_TIMEOUT=300
