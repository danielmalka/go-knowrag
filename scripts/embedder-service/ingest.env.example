# Copy to ~/.config/knowrag/ingest.env and fill in. systemd EnvironmentFile + the
# nightly-ingest.sh wrapper read this. No secrets belong in the unit files.
#
# Paths are install-specific. The repository keeps only this example.

KNOWRAG_ENV=/absolute/path/to/go-knowrag/.env.knowrag
KNOWRAG_DOTENV=/absolute/path/to/go-knowrag/.env
KNOWRAG_BIN=/absolute/path/to/go-knowrag/bin/cli
KNOWRAG_ENSURE=/absolute/path/to/go-knowrag/scripts/embedder-service/ensure-embedder.sh
# Checkout root — applied_state.json is resolved from the working directory.
KNOWRAG_WORKDIR=/absolute/path/to/go-knowrag
