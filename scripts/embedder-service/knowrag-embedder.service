[Unit]
# Serves BGE-M3 on loopback. `knowrag ingest` calls /tokenize at every chunk boundary and /embed
# per batch; the MCP server embeds every query. The same process does both — there is no
# query-only half of this model (see the embedder README, "Why ingest and query are not two
# services").
#
# This unit is NOT enabled. Boot must not load 2+ GB of weights. Two timers start it: the
# nightly ingest oneshot, and the daytime window so a search does not miss the MCP's 10 s
# deadline while the model is still loading (28-37 s).
#
# StartLimit* live here and not under [Service]. systemd ignores them there — silently, with only a
# line in `systemd-analyze verify` to say so — which is how the first version of this file ended up
# running with the 10 s default while its comment claimed 300.
Description=go-knowrag embedding service (BGE-M3)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# Every install-specific path is read from here, so this file carries none. See
# knowrag-embedder.env.example for the keys. Without the `-`, a missing file is a start failure
# rather than a service that comes up pointing at nothing.
EnvironmentFile=%h/.config/knowrag/embedder.env

# systemd expands variables in arguments but not in the executable itself, so the command runs
# through `sh -c`. The quoting is what makes a path with a space work, and `exec` is what keeps
# systemd supervising python rather than the shell that spawned it.
# KNOWRAG_EMBEDDER_IDLE_TIMEOUT is seconds of no /embed|/tokenize|/handshake before the
# process exits 0. Default 0: the daytime stop timer is what takes it down. Set it only if
# you drop the daytime window and accept that the first search after idle is an outage
# (MCP search deadline is 10 s; load is 28-37 s).
ExecStart=/bin/sh -c 'exec "$KNOWRAG_PYTHON" "$KNOWRAG_REPO/scripts/embedder-service/server.py" --host "$KNOWRAG_EMBEDDER_HOST" --port "$KNOWRAG_EMBEDDER_PORT" --idle-timeout "${KNOWRAG_EMBEDDER_IDLE_TIMEOUT:-0}"'

# There is deliberately no WorkingDirectory: server.py opens no file and builds no relative path, and
# the model comes from the Hugging Face cache under the user's home. An earlier version of this unit
# pinned a working directory and claimed the model cache depended on it. It does not.

# Start to ready is ~9 s for a restart like this one, where the page cache is still warm, and 28-37 s
# from a cold boot (measured off this unit's own journal; ADR-001 §6.2). Restarting is not free and a
# crash loop would thrash the GPU.
#
# on-failure, not always: an idle-timeout shutdown is exit 0, and Restart=always would bring the
# weights back the moment they were released. A crash still restarts.
Restart=on-failure
RestartSec=5

# The two numbers exist because this service is the largest single consumer on the machine and the
# machine is a WSL2 guest, where "out of memory" is not a Linux OOM kill: the guest still reported
# 5 GB available when the VM died. What the guest holds, Windows cannot reclaim, and an unbounded
# cgroup holds everything it ever read — measured at 6.2 GB current against 2.5 GB of actual RSS,
# the difference being page cache of the weights that nothing was asking it to give back.
#
# MemoryHigh is the one that does the work: above it the kernel reclaims, and page cache is what it
# reclaims first, which is exactly the part that was never needed. It throttles, it does not kill.
# MemoryMax is the backstop, set above the measured load peak so it never fires in normal operation.
# If it ever does, Restart=always brings the service back and the VM stays alive — which is the
# whole point. A dead embedder is a failed ingestion; a dead VM is a lost session.
MemoryHigh=4G
MemoryMax=7G

# The server refuses to start when the model stops normalising its vectors or returns an empty sparse
# half, so a failed start is a real signal and belongs in the journal.
StandardOutput=journal
StandardError=journal

[Install]
# Intentionally not wanted by default.target. Enabling this unit would load the model at
# every WSL boot. The timers start it; `systemctl --user start knowrag-embedder` is the
# manual path.
WantedBy=default.target
