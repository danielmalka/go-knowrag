[Unit]
# Serves EmbeddingGemma 2 (text, dense 768) on loopback, on the GPU only. `knowrag ingest` calls
# /tokenize at every chunk boundary and /embed per batch; the MCP server embeds every query. The
# same process does both -- there is one model and no query-only half of it.
#
# The PROCESS is always up; the MODEL is not. The service starts without touching the GPU, loads the
# weights on the first call that needs them (a few seconds) and gives the VRAM back after
# KNOWRAG_EMBEDDER_IDLE_UNLOAD seconds without one (default 600). So enabling this unit at login costs
# a Python process and one CUDA context, not a resident model. Ingestion has its own timer
# (knowrag-ingest.timer); it needs no start/stop window around it.
#
# StartLimit* live here and not under [Service]. systemd ignores them there -- silently, with only a
# line in `systemd-analyze verify` to say so.
Description=go-knowrag embedding service (EmbeddingGemma 2, GPU only)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# Every install-specific path and every tunable is read from here, so this file carries none. See
# knowrag-embedder.env.example for the keys. Without the `-`, a missing file is a start failure
# rather than a service that comes up pointing at nothing.
EnvironmentFile=%h/.config/knowrag/embedder.env

# systemd expands variables in arguments but not in the executable itself, so the command runs
# through `sh -c`; the quoting is what makes a path with a space work, and `exec` keeps systemd
# supervising python rather than the shell. server.py reads KNOWRAG_EMBEDDER_* from the environment.
ExecStart=/bin/sh -c 'exec "$KNOWRAG_PYTHON" "$KNOWRAG_REPO/scripts/embedder-service/server.py"'

# There is deliberately no WorkingDirectory: server.py opens no file by relative path, and the model
# comes from the Hugging Face cache under the user's home.

# on-failure, not always: a refusal to start (exit 78: no CUDA device, a CPU device or fp16 asked
# for) is a clear one-line failure in the journal, and restarting it would only repeat the line.
# RestartPreventExitStatus makes that explicit. A crash still restarts, after 5 s; StartLimitBurst
# stops a crash loop from thrashing the GPU.
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78

# Host-RAM bounds for the largest consumer on a WSL2 guest, where "out of memory" is not a Linux OOM
# kill: the guest can report GBs available while the VM dies, and what the guest holds Windows cannot
# reclaim. MemoryHigh does the work (above it the kernel reclaims page cache first, which throttles,
# it does not kill); MemoryMax is the backstop above the measured peak, so it never fires in normal
# operation. These bound system RAM, not VRAM: the batch and token ceiling in the env file are what
# bound the card. The measured numbers and how to change them are in README.md ("Memory").
MemoryHigh=3G
MemoryMax=5G

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
