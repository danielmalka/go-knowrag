# Install-specific values for knowrag-embedder.service. Copy to ~/.config/knowrag/embedder.env and
# fill in. It stays out of the repository because these values describe one machine, not the project.
# server.py reads every KNOWRAG_EMBEDDER_* key below directly from its environment.

# Interpreter of the virtualenv built from scripts/embedder-service/requirements.txt.
KNOWRAG_PYTHON=/absolute/path/to/venv/bin/python

# Checkout of this repository. The unit appends scripts/embedder-service/server.py to it.
KNOWRAG_REPO=/absolute/path/to/go-knowrag

# Loopback on purpose. The service has no authentication of any kind, so binding it to an address
# something else can reach hands the GPU to whoever asks.
KNOWRAG_EMBEDDER_HOST=127.0.0.1
KNOWRAG_EMBEDDER_PORT=7999

# --- optional; the values shown are the defaults ---------------------------------------------

# CUDA device. There is no CPU option: without a CUDA device the service refuses to start.
# KNOWRAG_EMBEDDER_DEVICE=cuda:0

# bf16 (default) or fp32. fp16 is refused: the model card says not to use it.
# KNOWRAG_EMBEDDER_PRECISION=bf16

# Seconds without a call before the model is unloaded and its VRAM returned. 0 = never unload.
# The first call after an unload pays the load again (a few seconds), so keep the MCP client's
# timeout above that.
# KNOWRAG_EMBEDDER_IDLE_UNLOAD=600

# Texts per forward pass, and the longest input /embed accepts (prefix and title included). Together
# they bound VRAM during ingestion; README.md ("Batch and token ceiling") has the measured peaks.
# The ceiling cannot exceed 8192, the model's window, and must stay above what the chunker emits.
# KNOWRAG_EMBEDDER_BATCH_SIZE=4
# KNOWRAG_EMBEDDER_MAX_INPUT_TOKENS=8192
