# Install-specific paths for knowrag-embedder.service. Copy to ~/.config/knowrag/embedder.env and
# fill in. It stays out of the repository because these values describe one machine, not the project.

# Interpreter of the virtualenv that has FlagEmbedding installed.
KNOWRAG_PYTHON=/absolute/path/to/venv/bin/python

# Checkout of this repository. The unit appends scripts/embedder-service/server.py to it.
KNOWRAG_REPO=/absolute/path/to/go-knowrag

# Loopback on purpose. The service has no authentication of any kind, so binding it to an address
# something else can reach hands the GPU to whoever asks.
KNOWRAG_EMBEDDER_HOST=127.0.0.1
KNOWRAG_EMBEDDER_PORT=7999
